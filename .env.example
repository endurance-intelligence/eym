# Optional overrides. The current public Supabase project values remain the fallback in src/services/supabase.js.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Registration is available by default so a fresh account can run through onboarding.
# Set this to false when the installation should be closed to new accounts.
VITE_ALLOW_SIGNUP=true
